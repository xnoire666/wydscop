<Window x:Class="Wydscop.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Wydscop"
        Width="614"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">

    <!--
        Windows 11 draws the background: an acrylic blur of what's behind the bar, rounded corners,
        a hairline border and the shadow (set up in SearchWindow.EnableAcrylic). The window is exactly
        the panel, and grows downward with the results (SizeToContent="Height").
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Widest the folder path on a result row may get; scales with the bar width (set in code). -->
        <sys:Double x:Key="SubtitleMaxWidth">260</sys:Double>

        <!-- All colors (Text.Primary, Row.Selected, AcrylicTint, …) come from Themes.cs: light gray or dark. -->

        <!--
            The realistic red push pin (glossy head, waist, base, steel needle), drawn upright on a 24x24
            canvas and tilted 40° like the pin icon. Used by the bar's pin and by pinned result rows.
        -->
        <DrawingImage x:Key="RedPinImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <!-- Fixed 24x24 bounds so the image keeps its size whatever the rotation -->
                    <GeometryDrawing Brush="Transparent" Geometry="M 0,0 L 24,0 L 24,24 L 0,24 Z" />
                    <DrawingGroup>
                        <DrawingGroup.Transform>
                            <RotateTransform Angle="40" CenterX="12" CenterY="12" />
                        </DrawingGroup.Transform>

                        <!-- Needle -->
                        <GeometryDrawing Geometry="M 11.15,14.5 L 12.85,14.5 L 12.35,21.6 L 12,23.2 L 11.65,21.6 Z">
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#5F646A" />
                                    <GradientStop Offset="0.45" Color="#D5D9DE" />
                                    <GradientStop Offset="1" Color="#464A4F" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>

                        <!-- Base -->
                        <GeometryDrawing Geometry="M 6,12.2 C 6,11.3 7,10.9 8,10.9 L 16,10.9 C 17,10.9 18,11.3 18,12.2 L 18,13.4 C 18,14.4 17,14.8 16,14.8 L 8,14.8 C 7,14.8 6,14.4 6,13.4 Z">
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#9E1414" />
                                    <GradientStop Offset="0.32" Color="#E8383A" />
                                    <GradientStop Offset="0.55" Color="#D42426" />
                                    <GradientStop Offset="1" Color="#7E0E0E" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>

                        <!-- Waist -->
                        <GeometryDrawing Geometry="M 9.4,6 L 14.6,6 L 13.6,11.2 L 10.4,11.2 Z">
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#8C1010" />
                                    <GradientStop Offset="0.35" Color="#E23436" />
                                    <GradientStop Offset="1" Color="#7A0D0D" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>

                        <!-- Head -->
                        <GeometryDrawing Geometry="M 7.2,3.6 C 7.2,2.2 8.6,1.4 10.2,1.4 L 13.8,1.4 C 15.4,1.4 16.8,2.2 16.8,3.6 L 16.8,5 C 16.8,6.4 15.4,7 13.8,7 L 10.2,7 C 8.6,7 7.2,6.4 7.2,5 Z">
                            <GeometryDrawing.Brush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FF6B6B" />
                                    <GradientStop Offset="0.4" Color="#E02B2D" />
                                    <GradientStop Offset="1" Color="#8A0F0F" />
                                </LinearGradientBrush>
                            </GeometryDrawing.Brush>
                        </GeometryDrawing>

                        <!-- Shine on the head and the base -->
                        <GeometryDrawing Brush="#99FFFFFF">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="10.4,2.85" RadiusX="1.8" RadiusY="0.75" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="#59FFFFFF">
                            <GeometryDrawing.Geometry>
                                <EllipseGeometry Center="9.1,12" RadiusX="1.5" RadiusY="0.5" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>

    <!-- Width is set in code from the saved width (default 614); drag either side edge to change it. -->
    <Grid x:Name="BarGrid" Width="614" VerticalAlignment="Top">

        <!-- Bar = 614 x 56 (DIP), same as Claude's Quick Entry. Background is set in code (AcrylicTint or SolidBackground). -->
        <Border x:Name="BarBorder">

            <StackPanel>
                <!-- Search row. Background="Transparent" makes the empty parts of the row clickable (for dragging). -->
                <Grid x:Name="BarRow" Height="56" Background="Transparent"
                      PreviewMouseLeftButtonDown="BarRow_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="BarRow_PreviewMouseMove">
                    <!-- icon | folder chip (while browsing a folder) | text | pin -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="53" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>

                    <!-- Search icon: 17x17, 19 from the left edge, in the logo's aurora gradient -->
                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="17"
                               Foreground="{DynamicResource SearchIcon}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Margin="18,0,0,0" />

                    <!-- The folder you're inside (Right arrow on a folder); Left arrow goes back. -->
                    <Border x:Name="FolderChip"
                            Grid.Column="1"
                            Visibility="Collapsed"
                            CornerRadius="6"
                            Background="{DynamicResource Chip.Background}"
                            Padding="8,3,10,3"
                            Margin="0,0,10,0"
                            MaxWidth="260"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="{DynamicResource Folder.Icon}"
                                       VerticalAlignment="Center"
                                       Margin="0,1,6,0" />
                            <TextBlock x:Name="FolderChipText"
                                       FontSize="14"
                                       Foreground="{DynamicResource Text.Primary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!-- Text starts 56 from the left edge -->
                    <!-- Rotating Gen Z lines (Services/Taglines.cs) while the bar is empty; "Search in …" inside a folder -->
                    <TextBlock x:Name="Placeholder"
                               Grid.Column="2"
                               Text="Wydscop search"
                               FontSize="17"
                               Foreground="{DynamicResource Text.Hint}"
                               VerticalAlignment="Center"
                               Margin="2,0,0,1"
                               TextTrimming="CharacterEllipsis"
                               IsHitTestVisible="False">
                        <TextBlock.RenderTransform>
                            <TranslateTransform x:Name="PlaceholderShift" />
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="2"
                             FontSize="17"
                             Foreground="{DynamicResource Text.Primary}"
                             CaretBrush="{DynamicResource Text.Primary}"
                             SelectionBrush="#4C8DFF"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             Margin="0,0,0,1"
                             VerticalAlignment="Center"
                             FocusVisualStyle="{x:Null}"
                             TextChanged="SearchBox_TextChanged" />

                    <!--
                        Pin: keeps the bar open (clicking elsewhere doesn't hide it) and in place.
                        Unpinned: gray outline pin. Pinned: a realistic red push pin, same in both themes.
                    -->
                    <ToggleButton x:Name="PinButton"
                                  Grid.Column="3"
                                  Width="32" Height="32"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Focusable="False"
                                  ToolTip="Pin (keep open)"
                                  Checked="PinButton_Changed"
                                  Unchecked="PinButton_Changed">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Bd" CornerRadius="8" Background="Transparent">
                                    <Grid>
                                        <!-- Unpinned: the gray outline pin icon -->
                                        <TextBlock x:Name="Glyph"
                                                   Text="&#xE718;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />

                                        <!-- Pinned: the realistic red push pin (RedPinImage), same in both themes -->
                                        <Image x:Name="RealPin"
                                               Source="{StaticResource RedPinImage}"
                                               Width="27" Height="27"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Image.Effect>
                                                <DropShadowEffect BlurRadius="2.5" ShadowDepth="1.2" Direction="300" Opacity="0.35" Color="Black" />
                                            </Image.Effect>
                                        </Image>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Button.HoverBackground}" />
                                        <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Icon.Hover}" />
                                    </Trigger>
                                    <!-- Pinned: show the red push pin instead of the outline icon; no colored background -->
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="RealPin" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>

                <!-- Results: hidden until there is something to show -->
                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                    <Border Height="1" Background="{DynamicResource Divider}" SnapsToDevicePixels="True" />

                    <!-- "Recent" above the list when the bar is empty -->
                    <TextBlock x:Name="SectionHeader"
                               Visibility="Collapsed"
                               FontSize="12"
                               Foreground="{DynamicResource Text.Muted}"
                               Margin="18,10,18,0" />

                    <!-- Shown while browsing a folder that is empty, or has nothing matching the text -->
                    <TextBlock x:Name="EmptyMessage"
                               Visibility="Collapsed"
                               FontSize="14"
                               Foreground="{DynamicResource Text.Muted}"
                               Margin="22,14,22,16" />

                    <!-- Grows with the results up to 10 rows (10 x 44 + 12 padding), then scrolls -->
                    <ListBox x:Name="ResultsList"
                             MaxHeight="452"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6"
                             Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.ScrollChanged="ResultsList_ScrollChanged"
                             PreviewMouseLeftButtonDown="ResultsList_PreviewMouseLeftButtonDown"
                             PreviewMouseLeftButtonUp="ResultsList_PreviewMouseLeftButtonUp"
                             MouseMove="ResultsList_MouseMove">
                        <ListBox.Resources>
                            <!-- Thin, dark scrollbar -->
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="6" />
                                <Setter Property="MinWidth" Value="6" />
                                <Setter Property="Margin" Value="4,2,0,2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                <Track.Thumb>
                                                    <Thumb>
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Border x:Name="ThumbBd" CornerRadius="3" Background="{DynamicResource Scroll.Thumb}" />
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource Scroll.ThumbHover}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="True">
                                                                        <Setter TargetName="ThumbBd" Property="Background" Value="{DynamicResource Scroll.ThumbDrag}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </Track.Thumb>
                                            </Track>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Height="44" CornerRadius="8" Background="Transparent">
                                                <Grid>
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                    <!-- Marked (Ctrl+click): a short accent bar on the left edge -->
                                                    <Border x:Name="MarkBar"
                                                            Width="3" Height="20"
                                                            CornerRadius="1.5"
                                                            Background="{DynamicResource Accent.Text}"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Margin="1,0,0,0"
                                                            IsHitTestVisible="False"
                                                            Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Row.Selected}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Row.Marked}" />
                                                    <Setter TargetName="MarkBar" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsMarked}" Value="True" />
                                                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Row.MarkedSelected}" />
                                                </MultiDataTrigger>
                                                <!-- Section headings ("Recent", "Pinned"): shorter, never highlighted -->
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter TargetName="Bd" Property="Height" Value="30" />
                                                    <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <!-- Plain headings ignore the mouse; one with "Clear all" must stay clickable -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsHeader}" Value="True" />
                                            <Condition Binding="{Binding HasHeaderAction}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsHitTestVisible" Value="False" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                              <Grid>
                                <!-- Section heading row ("Recent", "Pinned") -->
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12"
                                           Foreground="{DynamicResource Text.Muted}"
                                           VerticalAlignment="Bottom"
                                           IsHitTestVisible="False"
                                           Margin="12,0,12,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- "Clear all" on the right of the Recent heading, lined up with the dates -->
                                <!-- A small button (trash icon + text, red because it deletes) so it reads as clickable -->
                                <Border Tag="HeaderAction"
                                        Cursor="Hand"
                                        CornerRadius="6"
                                        Padding="8,3,10,3"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Margin="0,0,24,1">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasHeaderAction}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Danger.HoverBackground}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Danger.Text}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,1,6,0" />
                                        <TextBlock Text="{Binding HeaderAction}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Danger.Text}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Normal row. Icon lines up with the search icon, title with the typed text -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" /><!-- ✕ (recent rows only) -->
                                        <ColumnDefinition Width="49" />  <!-- icon -->
                                        <ColumnDefinition Width="*" />   <!-- name -->
                                        <ColumnDefinition Width="Auto" /><!-- path / "Application", date below -->
                                        <ColumnDefinition Width="Auto" /><!-- pin -->
                                        <ColumnDefinition Width="30" />  <!-- › -->
                                    </Grid.ColumnDefinitions>

                                    <Image Grid.Column="1"
                                           Source="{Binding Icon}"
                                           Width="24" Height="24"
                                           HorizontalAlignment="Left"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Margin" Value="11,0,0,0" />
                                                <Style.Triggers>
                                                    <!-- Recent rows have the ✕ before the icon: sit the icon closer to it -->
                                                    <DataTrigger Binding="{Binding IsRecent}" Value="True">
                                                        <Setter Property="Margin" Value="6,0,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- "Show more" row: a down chevron instead of an icon -->
                                    <TextBlock Grid.Column="1"
                                               Text="&#xE70D;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13"
                                               Foreground="{DynamicResource Accent.Text}"
                                               Width="24"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="11,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCommand}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Title}"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCommand}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Accent.Text}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!--
                                        Right side, two lines, right-aligned:
                                          the folder it's in (or "Application" / "Folder" / a file size)
                                          its date below: modified, or created if never modified ("Today 3:41 PM", "12 Nov 3:41 PM").
                                        Rows without a date just show the one line, centered.
                                    -->
                                    <StackPanel Grid.Column="3"
                                                VerticalAlignment="Center"
                                                Margin="12,0,4,0"
                                                MaxWidth="{DynamicResource SubtitleMaxWidth}">
                                        <TextBlock Text="{Binding Subtitle}"
                                                   ToolTip="{Binding Id}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Text.Muted}"
                                                   TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DateText}"
                                                   ToolTip="{Binding DateToolTip}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Text.Hint}"
                                                   TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DateText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!--
                                        › on folders: click it (or press Right) to look inside the folder right here.
                                        Hidden (not collapsed) on other rows so all paths stay aligned.
                                    -->
                                    <!--
                                        Pin: pins the result to the empty bar (or unpins it). Ctrl+P does the same.
                                        Gray outline pin on the row under the mouse / the highlighted row;
                                        pinned results always show the small red push pin.
                                    -->
                                    <Border Grid.Column="4"
                                            Tag="TogglePin"
                                            Width="26" Height="30"
                                            CornerRadius="6"
                                            Margin="4,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="ToolTip" Value="Pin (Ctrl+P)" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanPin}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding CanPin}" Value="True" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding CanPin}" Value="True" />
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Setter Property="ToolTip" Value="Unpin (Ctrl+P)" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Row.ButtonHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <TextBlock Text="&#xE718;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource Icon.Subtle}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{StaticResource RedPinImage}"
                                                   Width="21" Height="21"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="5"
                                            Tag="EnterFolder"
                                            Width="26" Height="30"
                                            CornerRadius="6"
                                            HorizontalAlignment="Left"
                                            ToolTip="Show what's inside (→)">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Hidden" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Row.ButtonHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="&#xE76C;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Icon.Subtle}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>

                                    <!--
                                        ✕ on Recent rows: removes the item from the Recent list (same as the Delete key).
                                        Shown on the row under the mouse or the highlighted row; the space is kept
                                        on other recent rows so the paths stay aligned. Not on search results.
                                    -->
                                    <Border Grid.Column="0"
                                            Tag="RemoveRecent"
                                            Width="26" Height="30"
                                            CornerRadius="6"
                                            Margin="4,0,0,0"
                                            ToolTip="Remove from Recent (Delete)">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRecent}" Value="True">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsRecent}" Value="True" />
                                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsRecent}" Value="True" />
                                                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource Row.ButtonHover}" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="&#xE711;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Icon.Subtle}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                              </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Resize handles: drag a side edge to change the width; double-click one to reset it. -->
        <Border x:Name="ResizeLeft"
                Width="6"
                HorizontalAlignment="Left"
                Background="Transparent"
                Cursor="SizeWE"
                ToolTip="Drag to resize. Double-click to reset."
                MouseLeftButtonDown="Resize_MouseLeftButtonDown"
                MouseMove="Resize_MouseMove"
                MouseLeftButtonUp="Resize_MouseLeftButtonUp" />
        <Border x:Name="ResizeRight"
                Width="6"
                HorizontalAlignment="Right"
                Background="Transparent"
                Cursor="SizeWE"
                ToolTip="Drag to resize. Double-click to reset."
                MouseLeftButtonDown="Resize_MouseLeftButtonDown"
                MouseMove="Resize_MouseMove"
                MouseLeftButtonUp="Resize_MouseLeftButtonUp" />
    </Grid>
</Window>