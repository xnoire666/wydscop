<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK version gives access to WinRT APIs (StartupTask, used when installed as MSIX).
         It still runs on Windows 10 1809 and later. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinForms-only advice; DPI awareness is set in app.manifest for WPF. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyTitle>Wydscop</AssemblyTitle>
    <Product>Wydscop</Product>
    <!-- The MSIX package version is this plus ".0" (the Store needs the last part to be 0). -->
    <Version>1.0.0</Version>
    <!-- Exe icon (Explorer, Start with Windows, Task Manager). Regenerate with tools/make-icon.py. -->
    <ApplicationIcon>Assets\Wydscop.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF / WinForms name clashes (Application, MessageBox, KeyEventArgs...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same icon, loaded at the right size for the tray (see TrayIcon.LoadIcon). -->
    <EmbeddedResource Include="Assets\Wydscop.ico" LogicalName="Wydscop.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The search classes are internal; the tests may use them. -->
    <InternalsVisibleTo Include="Wydscop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="11.0.0" />
  </ItemGroup>

</Project>
