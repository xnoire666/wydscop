<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only used for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WinForms-only advice; DPI awareness is set in app.manifest for WPF. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <AssemblyTitle>Wydscop</AssemblyTitle>
    <Product>Wydscop</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Avoid WPF / WinForms name clashes (Application, MessageBox, KeyEventArgs...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="11.0.0" />
  </ItemGroup>

</Project>
