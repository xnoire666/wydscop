# Normalize line endings: stored as LF in Git, checked out as CRLF on Windows (this is a Windows-only app).
* text=auto

*.cs       text eol=crlf diff=csharp
*.xaml     text eol=crlf
*.csproj   text eol=crlf
*.slnx     text eol=crlf
*.manifest text eol=crlf
*.props    text eol=crlf
*.targets  text eol=crlf
*.json     text eol=crlf
*.md       text eol=crlf
*.yml      text eol=lf
*.ps1      text eol=crlf

# Binary files: never touch
*.ico binary
*.png binary
*.jpg binary
*.gif binary
*.dll binary
*.exe binary
